{
  "name": "tripo3d-model-downloader",
  "private": true,
  "version": "10.0.0",
  "description": "Build pipeline for the Tripo3D Model Downloader userscript (multi-format + local converter).",
  "type": "module",
  "scripts": {
    "bundle": "esbuild src/converter.js --bundle --format=iife --global-name=TripoConverter --minify --legal-comments=none --platform=browser --target=es2020 --outfile=dist/tripo-converter.js",
    "build": "node build.mjs"
  },
  "dependencies": {
    "@comfyorg/fbx-exporter-three": "^1.0.2",
    "fflate": "^0.8.3",
    "three": "^0.186.1",
    "three-3mf-exporter": "^45.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
